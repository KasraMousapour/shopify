# ==========================================
# General Project Configuration
# ==========================================
PROJECT_NAME="Shopify Ecommerce"
DOMAIN="localhost"
FASTAPI_ENV="development"
SECRET_KEY="generate_a_random_32_character_secret_key"

# ==========================================
# Superuser / Admin Credentials
# ==========================================
FIRST_SUPERUSER="admin@shopify.local"
FIRST_SUPERUSER_PASSWORD="adminpassword123"

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_DB="app"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/app"

# ==========================================
# Frontend & Storefront Ports
# ==========================================
FRONTEND_HOST="http://localhost:5173"
STOREFRONT_HOST="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
BACKEND_API_URL="http://localhost:8000/api/v1"
