{
  "name": "shopify",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack modern e-commerce platform with Next.js storefront and FastAPI backend",
  "scripts": {
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev:storefront": "cd storefront && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000"
  },
  "author": "Kasra Mousapour",
  "license": "MIT"
}
